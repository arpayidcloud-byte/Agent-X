# 💻 Agent-X Environment Configurations

# 🗄️ Database Setup (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Recommended providers: Neon (neon.tech), Supabase (supabase.com), or Local Docker Postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/agentx?schema=public"

# 🤖 LLM Provider API Keys
# 🔧 Provider-Specific API Keys (OpenAI, Anthropic, DeepSeek, Qwen, OmniRoute, etc.)
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
QWEN_API_KEY="your-qwen-api-key"
GROQ_API_KEY="your-groq-api-key"

# 🌐 OpenAI-Compatible & Anthropic-Compatible Endpoints (Custom Routers like 9Router, OmniRoute, LiteLLM)
OPENAI_COMPATIBLE_API_KEY="optional-compat-key"
OPENAI_COMPATIBLE_ENDPOINT="https://api.openrouter.ai/v1"
ANTHROPIC_COMPATIBLE_API_KEY="optional-compat-key"
ANTHROPIC_COMPATIBLE_ENDPOINT="https://api.anthropic.com/v1"

# 🧠 LLM Router Config (Agent-X Internal)
LLM_PROVIDER_DEFAULT="openai_compatible"
LLM_PROVIDER_FALLBACK="deepseek"
LLM_PROVIDER_BACKUP="qwen"
LLM_CACHE_ENABLED="true"
LLM_CACHE_TTL_MS="3600000"

# 🌐 API Gateways & Servers Configuration
PORT=4000
API_BASE_URL="http://localhost:4000/api/v1"
WEB_URL="http://localhost:3000"

# 🧪 Dev/Demo Mode (no API keys required)
# Set to "true" to register mock providers (openai, deepseek, anthropic) so the
# API server can run LLM requests locally for development & monitoring demos.
ENABLE_MOCK_PROVIDER="false"

# 🔒 JWT & Session Security
JWT_SECRET="generate-a-long-random-string-here-for-security"
SESSION_SECRET="another-long-random-string"

# 🌐 OAuth Social Login (Optional — leave empty to disable)
# Create an OAuth app: Google Cloud Console / GitHub Developer Settings /
# Apple Developer (Certificates, Identifiers & Profiles → Keys + Services ID).
# OAUTH_BASE_URL is the API base the provider redirects back to (must be
# reachable from the internet; use https in production).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Apple Sign In: APPLE_CLIENT_ID = Services ID, APPLE_TEAM_ID = 10-char team ID,
# APPLE_KEY_ID = key ID of the Sign In with Apple key, APPLE_PRIVATE_KEY = P8
# private key PEM (single-line, with \n or as base64 of the PEM).
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
OAUTH_BASE_URL="http://localhost:30400"
OAUTH_WEB_URL="http://localhost:30500"

# 📊 Telemetry & Observability (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
PROMETHEUS_PORT=9090

# 💻 Agent-X Environment Configurations

# 🗄️ Database Setup (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Recommended providers: Neon (neon.tech), Supabase (supabase.com), or Local Docker Postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/agentx?schema=public"

# 🤖 LLM Provider API Keys
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
GROQ_API_KEY="your-groq-api-key"

# 🌐 API Gateways & Servers Configuration
PORT=4000
API_BASE_URL="http://localhost:4000/api/v1"
WEB_URL="http://localhost:3000"

# 🔒 JWT & Session Security
JWT_SECRET="generate-a-long-random-string-here-for-security"
SESSION_SECRET="another-long-random-string"

# 📊 Telemetry & Observability (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
PROMETHEUS_PORT=9090

generator client {
  provider      = "prisma-client-js"
  // Pin the engine binary explicitly: prisma generate can't detect the
  // openssl version during docker builds (no openssl CLI) and would emit a
  // 1.1.x engine that fails at runtime on Debian bookworm (openssl 3).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id                String    @id @default(cuid())
  goal              String
  status            String
  priority          String
  parentTaskId      String?
  rootTaskId        String
  assignedAgentRole String?
  dependsOn         String[]
  traceId           String
  metadata          Json
  context           Json
  result            Json?
  error             Json?
  orgId             String? // isolasi per-org (RLS app-level dulu)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  children Task[]  @relation("TaskHierarchy")
  parent   Task?   @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  events   Event[]

  @@index([rootTaskId, status])
  @@index([assignedAgentRole, status])
  @@index([orgId])
}

model Event {
  id        String   @id @default(cuid())
  topic     String
  payload   Json
  taskId    String?
  createdAt DateTime @default(now())

  task Task? @relation(fields: [taskId], references: [id])

  @@index([topic, createdAt])
  @@index([taskId])
}

model Approval {
  id         String    @id @default(cuid())
  taskId     String    @unique
  status     String    @default("PENDING")
  reason     String?
  approvedBy String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
}

model Memory {
  id         String   @id @default(cuid())
  type       String
  content    String
  importance Int      @default(50)
  sessionId  String?
  taskId     String?
  metadata   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([type, importance])
  @@index([sessionId])
  @@index([taskId])
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  roles              String[]
  emailVerified      Boolean  @default(false)
  orgId              String? // default org (opsional, primary org)
  verificationToken  String?
  stripeCustomerId   String?  @unique
  midtransCustomerId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members OrganizationMember[]
}

// Email verification tokens — one per user, consumed on verify.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime

  @@index([email])
  @@index([expiresAt])
}

// Refresh tokens — persisted so they survive server restarts (replaces in-memory Map).
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

// LLM provider connections managed by admins via the web UI
// (OpenAI-compatible / Anthropic-compatible endpoints). The API key is
// stored encrypted (AES-256-GCM, see apps/api/src/crypto.ts) — never plain.
model LlmProvider {
  id              String    @id @default(cuid())
  name            String    @unique
  type            String // 'openai-compatible' | 'anthropic-compatible'
  baseUrl         String
  apiKeyEncrypted String
  models          Json // [{ id, name, inputCostPerMillion, outputCostPerMillion, capabilities[], complexityRating }]
  enabled         Boolean   @default(true)
  // Admin panel (panel.id-tech.cloud): native preset slug + auth method.
  provider        String?   @default("custom") // 'openai' | 'grok' | 'deepseek' | 'qwen' | 'claude' | 'gemini' | 'mistral' | 'openrouter' | 'groq' | 'perplexity' | 'custom'
  authMethod      String    @default("api-key") // 'api-key' | 'oauth' | 'account'
  accountRef      String? // e.g. 'google:<email>' for OAuth/account connections
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Admin action audit trail (who did what, when).
model AdminAuditLog {
  id        String   @id @default(cuid())
  email     String
  action    String // 'create' | 'update' | 'delete' | 'test' | 'import' | 'export'
  target    String // provider name / resource identifier
  detail    Json?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([target, createdAt])
}

// CLI sync token (agentx config pull). Only the SHA-256 hash is stored;
// the plaintext token is shown once at creation and can be revoked.
model CliToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  name       String    @default("default")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([createdAt])
}

/// Combo provider: a named group of member providers resolved at request time.
/// CLI/API users can set provider = group name; the server picks members in
/// order (priority) or rotates (round-robin) with automatic failover.
model ProviderGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  strategy    String   @default("priority") // 'priority' | 'round-robin'
  members     Json // [{ provider: string }] in priority order
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WaitlistEntry {
  id        String   @id
  email     String   @unique
  name      String?
  source    String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model FeedbackEntry {
  id        String   @id
  email     String?
  category  String
  message   String
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, createdAt])
}

model QualityScore {
  id         String   @id
  taskId     String?
  orgId      String?
  prompt     String
  response   String
  provider   String?
  model      String?
  dimensions Json
  overall    Int
  grade      String
  evaluator  String   @default("heuristic")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([provider, createdAt])
}

// A/B experiment for model comparison (Phase 8, #115)
model EvalExperiment {
  id        String   @id @default(cuid())
  name      String
  prompt    String
  providerA String
  modelA    String
  providerB String
  modelB    String
  scoreA    Int
  scoreB    Int
  winner    String // 'A' | 'B' | 'tie'
  gradeA    String
  gradeB    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([winner])
}

model AgentFeedback {
  id                String   @id
  scoreId           String   @unique
  taskId            String?
  orgId             String?
  prompt            String
  response          String
  overall           Int
  grade             String
  weakDimensions    Json
  priorityAdvice    Json
  improvementPrompt String
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([grade, createdAt])
}

// Prompt template library — save, version, reuse prompts
model PromptTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     String
  tags        String[]
  version     Int      @default(1)
  usageCount  Int      @default(0)
  createdBy   String? // user id or 'system'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([tags])
  @@index([createdAt])
}

model CostEntry {
  id             String   @id @default(cuid())
  taskId         String?
  userId         String?
  orgId          String? // untuk alokasi biaya per-org
  subscriptionId String?
  provider       String // e.g. "openai", "deepseek", "anthropic"
  model          String // e.g. "gpt-4", "deepseek-v3"
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  costUsd        Float    @default(0)
  latencyMs      Int      @default(0)
  cached         Boolean  @default(false)
  source         String   @default("api") // "api", "cli", "web", "multi-agent"
  createdAt      DateTime @default(now())

  @@index([taskId])
  @@index([userId])
  @@index([provider])
  @@index([createdAt])
  @@index([orgId])
}

model AgentTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?
  authorId     String // user id
  authorName   String // display name
  systemPrompt String?
  tags         String[]
  category     String? // "productivity", "coding", "research", "creative"
  priceUsd     Float    @default(0) // 0 = free
  installCount Int      @default(0)
  rating       Float    @default(0)
  ratingCount  Int      @default(0)
  isPublished  Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  config       Json? // extra config (model, provider, params)
  orgId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([authorId])
  @@index([category])
  @@index([isPublished])
  @@index([installCount])
  @@index([rating])
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  nodes       Json     @default("[]") // React Flow nodes array
  edges       Json     @default("[]") // React Flow edges array
  isPublished Boolean  @default(false)
  ownerId     String?
  orgId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([isPublished])
  @@index([orgId])
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  planId        String? // FK Plan.id
  plan          Plan?                @relation(fields: [planId], references: [id])
  status        String               @default("active") // active | suspended | deleted
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       OrganizationMember[]
  subscriptions Subscription[]
  invoices      Invoice[]
}

model OrganizationMember {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      String       @default("member") // owner | admin | member | viewer
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Plan {
  id               String   @id @default(cuid())
  slug             String   @unique // free | pro | team | enterprise | flex
  name             String
  priceUsd         Int // cents: 0, 2900, 9900, 49900
  interval         String   @default("month") // month | year
  maxTasksPerMonth Int
  maxMembers       Int      @default(1)
  features         Json // ["tasks:100","analytics:false",...]
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Opposite relation fields (required by Prisma for Organization.plan / Subscription.plan)
  organizations Organization[]
  subscriptions Subscription[]
}

model Subscription {
  id                    String       @id @default(cuid())
  orgId                 String
  userId                String? // creator
  planId                String
  status                String // trialing | active | past_due | canceled | incomplete
  gateway               String // stripe | midtrans
  gatewayCustomerId     String?
  gatewaySubscriptionId String?      @unique
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  trialEndsAt           DateTime?
  cancelAtPeriodEnd     Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan                  Plan         @relation(fields: [planId], references: [id])

  @@index([orgId, status])
  @@index([gatewaySubscriptionId])
}

model Invoice {
  id               String       @id @default(cuid())
  orgId            String
  subscriptionId   String?
  gateway          String
  gatewayInvoiceId String?      @unique
  amountCents      Int
  currency         String       @default("usd") // usd | idr
  status           String // draft | open | paid | void | uncollectible
  hostedInvoiceUrl String?
  pdfUrl           String?
  periodStart      DateTime?
  periodEnd        DateTime?
  paidAt           DateTime?
  createdAt        DateTime     @default(now())
  org              Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
}

model Entitlement {
  id          String   @id @default(cuid())
  orgId       String   @unique
  tasksUsed   Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  updatedAt   DateTime @updatedAt

  @@index([periodEnd])
}

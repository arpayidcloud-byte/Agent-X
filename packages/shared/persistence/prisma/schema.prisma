generator client {
  provider = "prisma-client-js"
  // Pin the engine binary explicitly: prisma generate can't detect the
  // openssl version during docker builds (no openssl CLI) and would emit a
  // 1.1.x engine that fails at runtime on Debian bookworm (openssl 3).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id          String   @id @default(cuid())
  goal        String
  status      String
  priority    String
  parentTaskId String?
  rootTaskId  String
  assignedAgentRole String?
  dependsOn   String[]
  traceId     String
  metadata    Json
  context     Json
  result      Json?
  error       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?
  
  children    Task[]   @relation("TaskHierarchy")
  parent      Task?    @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  events      Event[]
  
  @@index([rootTaskId, status])
  @@index([assignedAgentRole, status])
}

model Event {
  id        String   @id @default(cuid())
  topic     String
  payload   Json
  taskId    String?
  createdAt DateTime @default(now())
  
  task      Task?    @relation(fields: [taskId], references: [id])
  
  @@index([topic, createdAt])
  @@index([taskId])
}

model Approval {
  id        String   @id @default(cuid())
  taskId    String   @unique
  status    String   @default("PENDING")
  reason    String?
  approvedBy String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  
  @@index([status])
}

model Memory {
  id          String   @id @default(cuid())
  type        String
  content     String
  importance  Int      @default(50)
  sessionId   String?
  taskId      String?
  metadata    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([type, importance])
  @@index([sessionId])
  @@index([taskId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  roles        String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WaitlistEntry {
  id        String   @id
  email     String   @unique
  name      String?
  source    String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model FeedbackEntry {
  id        String   @id
  email     String?
  category  String
  message   String
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, createdAt])
}

model QualityScore {
  id         String   @id
  taskId     String?
  prompt     String
  response   String
  provider   String?
  model      String?
  dimensions Json
  overall    Int
  grade      String
  evaluator  String   @default("heuristic")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([provider, createdAt])
}

model AgentFeedback {
  id                String   @id
  scoreId           String   @unique
  taskId            String?
  prompt            String
  response          String
  overall           Int
  grade             String
  weakDimensions    Json
  priorityAdvice    Json
  improvementPrompt String
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([grade, createdAt])
}
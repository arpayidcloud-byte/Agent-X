{
  "name": "@agent-xai/cli",
  "version": "0.1.0",
  "description": "AgentX CLI — Cloud-first AI agent platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arpayidcloud-byte/Agent-X.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "agentx": "./bin/agentx"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --build",

    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "5.4.5",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4"
  }
}

# syntax=docker/dockerfile:1
# Agent-X web dashboard image (Next.js standalone, pnpm monorepo).
# Build with:
#   NEXT_PUBLIC_API_URL=http://<host>:30400 docker build -f apps/web/Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=http://localhost:30400 -t agentx-web:dev .
#
# NOTE: base image is node:22-slim (Debian/glibc), NOT alpine. musl's
# getaddrinfo fails to resolve CNAME chains (e.g. api.id-tech.cloud ->
# <tunnel>.cfargotunnel.com -> multiple A records), which broke all
# server-side fetches from the pod (dns.lookup ENOTFOUND while c-ares
# resolve4 works). glibc handles CNAMEs correctly.

FROM node:22-slim AS build
WORKDIR /app
# Match the pnpm version that produced pnpm-lock.yaml (host: 9.15.0).
RUN npm install -g pnpm@9.15.0
COPY . .
ARG NEXT_PUBLIC_API_URL=http://localhost:30400
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @agent-xai/web build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
# Next.js standalone server (keeps the monorepo path structure).
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]

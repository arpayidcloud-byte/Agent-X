# syntax=docker/dockerfile:1
# Public marketing service for id-tech.cloud.
# Build from repository root:
#   docker build -f apps/landing/Dockerfile.landing -t agentx-landing:<tag> .

FROM node:22-slim AS build
WORKDIR /app
RUN npm install -g pnpm@9.15.0
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter @agent-xai/landing build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=build /app/apps/landing/.next/standalone ./
COPY --from=build /app/apps/landing/.next/static ./apps/landing/.next/static
EXPOSE 3000
CMD ["node", "apps/landing/server.js"]
